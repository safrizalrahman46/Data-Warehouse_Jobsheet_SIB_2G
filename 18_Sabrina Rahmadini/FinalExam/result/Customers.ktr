        <replace>N</replace>
      </field>
      <field>
        <name>AgeGroupLabel</name>
        <rename>AgeGroupLabel</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
