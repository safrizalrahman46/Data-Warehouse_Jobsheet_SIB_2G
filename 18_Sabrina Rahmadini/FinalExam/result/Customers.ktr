        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Grouping Income
var IncomeGroupKey = 0;
var IncomeGroupLabel = "";

if (typeof Annual_Income_k !== "undefined" &amp;&amp; !isNaN(Annual_Income_k)) {
  if (Annual_Income_k &lt;= 40) {
    IncomeGroupKey = 1;
    IncomeGroupLabel = "Low";
  } else if (Annual_Income_k &lt;= 70) {
    IncomeGroupKey = 2;
    IncomeGroupLabel = "Medium";
  } else {
    IncomeGroupKey = 3;
    IncomeGroupLabel = "High";
  }
}
</jsScript_script>
      </jsScript>
    </jsScripts>
