        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var AgeGroupKey = 0;
var AgeGroupLabel = "";

if (Age &lt;= 25) {
   AgeGroupKey = 1;
   AgeGroupLabel = "Youth";
} else if (Age &lt;= 40) {
   AgeGroupKey = 2;
   AgeGroupLabel = "Adult";
} else {
   AgeGroupKey = 3;
   AgeGroupLabel = "Senior";
}
</jsScript_script>
